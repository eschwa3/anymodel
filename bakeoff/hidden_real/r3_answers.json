{
  "questions": [
    {
      "id": "Q1",
      "prompt": "When a job's retry count reaches the configured limit, what releases its reservation, and what exactly decides dead-lettering vs. another retry? Name the function(s) and the precise condition.",
      "fact_groups": [
        {"keywords": ["fail_job"], "weight": 1.0},
        {"keywords": ["scheduler.py", "jobsched.scheduler", "scheduler"], "weight": 0.5},
        {"keywords": ["next_retry_count >= cfg.max_job_retries", ">= cfg.max_job_retries", ">= max_job_retries", "retry_count + 1"], "weight": 1.0},
        {"keywords": ["mark_dead"], "weight": 1.0},
        {"keywords": ["mark_failed_retry"], "weight": 0.5},
        {"keywords": ["release_reservation"], "weight": 1.0}
      ],
      "wrong_claims": [
        ["no retry limit", "retried indefinitely", "retries forever"],
        ["reservation is never released", "stays reserved forever", "reservation is not released on failure"],
        ["backoff delay", "exponential backoff", "waits before retrying"]
      ]
    },
    {
      "id": "Q2",
