        {"keywords": ["PlanChangeRepository"], "weight": 1.0},
        {"keywords": ["generate_invoice"], "weight": 1.0},
        {"keywords": ["list_for_period"], "weight": 1.0},
        {"keywords": ["prorat"], "weight": 0.5}
      ],
      "wrong_claims": [
