        {"keywords": ["compute_tax"], "weight": 1.0},
        {"keywords": ["billing.py", "jobsched.billing"], "weight": 0.5},
        {"keywords": ["round_half_up"], "weight": 1.0}
      ],
      "wrong_claims": [
        ["rounding_mode", "tax_rounding_mode"],
        ["repository.py computes tax", "tax is computed in repository"],
        ["currency affects", "currency changes the rounding", "currency determines the rounding", "re:\\b(two|both|2)\\s+(appconfig\\s+)?keys\\b[^.\\n]{0,160}\\bcurrency\\b", "re:tax_rate_bp`?\\s*(and|,|&)\\s*`?currency"]
      ]
    },
    {
      "id": "Q3",
      "prompt": "Trace what happens when a customer's plan is changed mid-cycle: which function/table records the change, and how does invoice generation pick it up?",
      "fact_groups": [
        {"keywords": ["change_plan"], "weight": 1.0},
